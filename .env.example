# One of the two is enough.

# A direct OpenAI key — works without a Vercel account
OPENAI_API_KEY=sk-...

# Or the Vercel AI Gateway (on Vercel it is filled in by the OIDC token)
# AI_GATEWAY_API_KEY=vck_...

# Models can be overridden without touching the code:
# AVATAR_MODEL=openai/gpt-5.2
# EVALUATOR_MODEL=openai/gpt-5.2
